# ds4xbox - hide PlayStation controllers from userspace
#
# This file MUST be installed as 72-ds4xbox.rules.  It has to run after
# 70-uaccess.rules (which adds TAG+="uaccess") and before
# 73-seat-late.rules (which applies the ACL).  Removing the tag before
# seat-late is what actually prevents the logged-in user from opening the
# original controller nodes.
#
# The daemon runs as root, grabs the gamepad and optional touchpad evdev nodes
# with EVIOCGRAB, and creates a virtual Xbox 360/One pad with /dev/uinput.
# The original Sony nodes (including unused sensors and audio nodes) are left
# at 0600 root:root so user programs cannot open them.
#
# If your distribution numbers its rules differently, keep this file
# between the uaccess rule and the seat-late rule.

ACTION=="remove", GOTO="ds4xbox_end"

# Hide the original controller only while ds4xbox is running.  The daemon
# creates this flag on startup and removes it on shutdown; it also triggers
# a udev "change" so the original device becomes visible again when the
# daemon stops.
TEST=="/run/ds4xbox/active", GOTO="ds4xbox_hide"

# Daemon stopped: explicitly undo the properties that could otherwise remain
# in the udev database, so the original controller is fully usable again.
SUBSYSTEM=="input", KERNELS=="*054C:*", \
    ENV{LIBINPUT_IGNORE_DEVICE}="", MODE="0660", GROUP="input", \
    TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="*054C:*", \
    MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="054c", \
    MODE="0660", GROUP="input", TAG+="uaccess"

SUBSYSTEM=="input", ATTRS{name}=="*DualShock*", \
    ENV{LIBINPUT_IGNORE_DEVICE}="", MODE="0660", GROUP="input", \
    TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{name}=="*DualShock*", \
    MODE="0660", GROUP="input", TAG+="uaccess"

SUBSYSTEM=="input", ATTRS{name}=="*DualSense*", \
    ENV{LIBINPUT_IGNORE_DEVICE}="", MODE="0660", GROUP="input", \
    TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{name}=="*DualSense*", \
    MODE="0660", GROUP="input", TAG+="uaccess"

SUBSYSTEM=="input", ATTRS{name}=="*PlayStation*", \
    ENV{LIBINPUT_IGNORE_DEVICE}="", MODE="0660", GROUP="input", \
    TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{name}=="*PlayStation*", \
    MODE="0660", GROUP="input", TAG+="uaccess"

SUBSYSTEM=="input", ATTRS{name}=="*PS4*", \
    ENV{LIBINPUT_IGNORE_DEVICE}="", MODE="0660", GROUP="input", \
    TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{name}=="*PS4*", \
    MODE="0660", GROUP="input", TAG+="uaccess"

SUBSYSTEM=="input", ATTRS{name}=="*Sony Interactive Entertainment*", \
    ENV{LIBINPUT_IGNORE_DEVICE}="", MODE="0660", GROUP="input", \
    TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{name}=="*Sony Interactive Entertainment*", \
    MODE="0660", GROUP="input", TAG+="uaccess"

SUBSYSTEM=="input", ATTRS{name}=="*Sony Computer Entertainment*", \
    ENV{LIBINPUT_IGNORE_DEVICE}="", MODE="0660", GROUP="input", \
    TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{name}=="*Sony Computer Entertainment*", \
    MODE="0660", GROUP="input", TAG+="uaccess"

GOTO="ds4xbox_virtual"

LABEL="ds4xbox_hide"

# ---------------------------------------------------------------------------
# Sony PlayStation controllers: USB and Bluetooth HID IDs
# ---------------------------------------------------------------------------

SUBSYSTEM=="input", KERNELS=="*054C:05C4*", \
    ENV{LIBINPUT_IGNORE_DEVICE}="1", \
    ENV{ID_INPUT}="", ENV{ID_INPUT_JOYSTICK}="", \
    ENV{ID_INPUT_KEY}="", ENV{ID_INPUT_KEYBOARD}="", \
    ENV{ID_INPUT_MOUSE}="", ENV{ID_INPUT_TOUCHPAD}="", \
    ENV{ID_INPUT_TOUCHSCREEN}="", ENV{ID_INPUT_TABLET}="", \
    ENV{ID_INPUT_ACCELEROMETER}="", ENV{ID_INPUT_POINTINGSTICK}="", \
    ENV{ID_INPUT_SWITCH}="", ENV{ID_INPUT_VIDEO}="", \
    TAG-="uaccess", OWNER="root", GROUP="root", MODE="0600"

SUBSYSTEM=="hidraw", KERNELS=="*054C:05C4*", \
    TAG-="uaccess", OWNER="root", GROUP="root", MODE="0600"

SUBSYSTEM=="usb", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="05c4", \
    TAG-="uaccess", OWNER="root", GROUP="root", MODE="0600"

