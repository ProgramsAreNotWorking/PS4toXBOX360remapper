# ---------------------------------------------------------------------------
# Virtual Xbox pads created by ds4xbox: make them usable by the seat user
# ---------------------------------------------------------------------------
LABEL="ds4xbox_virtual"

SUBSYSTEM=="input", ATTRS{name}=="Microsoft X-Box 360 pad", \
    ENV{ID_INPUT}="1", ENV{ID_INPUT_JOYSTICK}="1", \
    MODE="0660", GROUP="input", TAG+="uaccess"

SUBSYSTEM=="input", ATTRS{name}=="Microsoft X-Box One pad", \
    ENV{ID_INPUT}="1", ENV{ID_INPUT_JOYSTICK}="1", \
    MODE="0660", GROUP="input", TAG+="uaccess"

LABEL="ds4xbox_end"
